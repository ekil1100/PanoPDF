{
  "name": "panopdf",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "A panoramic desktop PDF reader",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "bun scripts/prepare-electron.mjs && bun scripts/dev.mjs",
    "dev:web": "vp dev --host 127.0.0.1",
    "check": "vp check",
    "build": "tsc --noEmit && vp build",
    "start": "bun scripts/prepare-electron.mjs && electron .",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "dist": "bun run build && electron-builder"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0",
    "pdfjs-dist": "6.4.299",
    "solid-js": "1.9.15",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.4",
    "autoprefixer": "^10.6.1",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plugin-solid": "2.11.14",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "packageManager": "bun@1.4.0",
  "build": {
    "appId": "com.panopdf.reader",
    "productName": "PanoPDF",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "licenses/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "role": "Viewer"
      }
    ]
  },
  "trustedDependencies": [
    "electron",
    "electron-winstaller"
  ]
}
